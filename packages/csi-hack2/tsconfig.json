{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "baseUrl": ".", // Set baseUrl to current directory
    "paths": {
      "*": ["node_modules/*"] // Allow imports from root node_modules
    },
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"], // Ensure types from root are available
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"]
}
